{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aether Capture Event",
  "type": "object",
  "required": [
    "captureId",
    "sourceType",
    "capturedAt",
    "contentText",
    "qualityScore",
    "riskLevel",
    "privacyLevel"
  ],
  "properties": {
    "captureId": { "type": "string" },
    "sourceType": {
      "type": "string",
      "enum": ["url", "github_repo", "local_file", "manual_note", "ocr_text", "translation", "rss", "other"]
    },
    "sourceUrl": { "type": "string" },
    "sourcePath": { "type": "string" },
    "sourceApp": { "type": "string" },
    "windowTitle": { "type": "string" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "contentText": { "type": "string" },
    "contentHash": { "type": "string" },
    "language": { "type": "string" },
    "qualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "riskLevel": { "type": "integer", "minimum": 1, "maximum": 4 },
    "privacyLevel": {
      "type": "string",
      "enum": ["public", "personal", "sensitive", "blocked"]
    },
    "rightsNote": { "type": "string" },
    "captureMethod": { "type": "string" },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true
    },
    "ocrBlocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "bbox", "confidence", "source"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "string", "enum": ["mock", "ocr", "uia", "manual"] }
        }
      }
    }
  },
  "additionalProperties": false
}
